# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Canonical site URL for metadata / Open Graph (no trailing slash). Use your BuckParts domain in production.
NEXT_PUBLIC_SITE_URL=https://your-buckparts-domain.example

# Optional: override the public product name in the header and default metadata (default: BuckParts)
# NEXT_PUBLIC_SITE_NAME=BuckParts

# Server-only: private owner dashboard (`/ownerdashboard/<secret>`). Use a long random value; never commit a real secret.
OWNER_DASHBOARD_SECRET=

# Server-only: CSV import scripts (scripts/import-seed.ts). Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Server-only: Google Search Console scheduled artifact fetch (scripts/fetch-buckparts-gsc-artifact.ts).
# Auth mode priority:
# 1) OAuth refresh token mode (recommended when service-account key creation is blocked):
#    - GSC_OAUTH_CLIENT_ID
#    - GSC_OAUTH_CLIENT_SECRET
#    - GSC_OAUTH_REFRESH_TOKEN
# 2) Service account mode:
#    - GSC_SERVICE_ACCOUNT_JSON as single-line JSON string, OR
#    - GSC_SERVICE_ACCOUNT_KEY_PATH as absolute path on the server (do not commit key files).
# All values are server-only secrets; never expose in browser/client code.
GSC_PROPERTY_SITE_URL=
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=
GSC_SERVICE_ACCOUNT_JSON=
GSC_SERVICE_ACCOUNT_KEY_PATH=
